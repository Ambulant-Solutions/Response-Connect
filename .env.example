SECRET_KEY=change-this-secret-key

POSTGRES_DB=response_connect
POSTGRES_USER=response_connect
POSTGRES_PASSWORD=response_connect
DB_HOST=db
DB_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Outgoing email
MAIL_SERVER=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=Response Connect <noreply@example.org>
MAIL_TIMEOUT=30

# Email branding
MAIL_BRAND_NAME=Response Connect
MAIL_SUPPORT_EMAIL=support@example.org
MAIL_PUBLIC_URL=http://localhost:8000

# Password reset
PASSWORD_RESET_TOKEN_MAX_AGE=3600
PASSWORD_RESET_SALT=response-connect-password-reset

# S3-compatible object storage
S3_REGION=us-east-1
S3_ACCESS_KEY=response_connect
S3_SECRET_KEY=replace-with-a-long-random-secret
S3_BUCKET=response-connect-files

# Managed file uploads
FILE_UPLOAD_MAX_BYTES=26214400
FILE_UPLOAD_SPOOL_MAX_BYTES=5242880
